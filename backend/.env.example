# ============================================================
# VIABILIDADE SAAS — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env no git
# ============================================================

# ---- Aplicação ----
APP_NAME="Viabilidade SaaS"
APP_VERSION="0.1.0"
DEBUG=false

# ---- Banco de Dados (PostgreSQL) ----
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viabilidade_db

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- JWT / Segurança ----
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-segura-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 horas

# ---- Upload de Arquivos ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ---- Mercado Livre ----
MERCADOLIVRE_BASE_URL=https://api.mercadolibre.com
MERCADOLIVRE_SITE_ID=MLB
ML_REQUEST_DELAY_SECONDS=1.0      # Throttle entre requests (respeita rate limit)
ML_FEE_PCT=15.0                   # Taxa ML padrão (%)
MIN_SALES_THRESHOLD=1000          # Mínimo de vendas para considerar anúncio

# ---- Claude API (Anthropic) ----
CLAUDE_API_KEY=sk-ant-sua-chave-aqui
CLAUDE_MODEL=claude-3-5-haiku-20241022  # Modelo mais barato para normalização

# ---- CORS (Frontend) ----
# Separe múltiplas origens por vírgula
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
