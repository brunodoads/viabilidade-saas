# ============================================================
# VIABILIDADE SAAS — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env no git
# ============================================================

# ---- Aplicação ----
APP_NAME="Viabilidade SaaS"
APP_VERSION="0.1.0"
DEBUG=false

# ---- Banco de Dados (PostgreSQL) ----
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viabilidade_db

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- JWT / Segurança ----
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-segura-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 horas

# ---- Upload de Arquivos ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ---- Apify (busca ML — OBRIGATÓRIO para dados reais) ----
# O endpoint /sites/MLB/search do ML está bloqueado para developers sem certificação.
# O Apify contorna esse bloqueio via scraper mantido ativamente.
#
# Como configurar:
#   1. Crie conta em apify.com (plano gratuito tem $5 de crédito)
#   2. Acesse: console.apify.com/settings/integrations
#   3. Copie o "Personal API token"
#   4. Cole abaixo
#
# Custo estimado MVP: ~$0.03 para 400 produtos (< $1/1000 resultados)
APIFY_API_TOKEN=
APIFY_ML_ACTOR_ID=karamelo~mercadolivre-scraper-brasil-portugues

# ---- Mercado Livre ----
# Credenciais ML são OPCIONAIS com Apify configurado.
# Usadas apenas para enriquecer sold_quantity via /items/{id} (endpoint não bloqueado).
# Sem essas credenciais, sold_quantity ainda é obtido sem autenticação (funciona para itens públicos).
MERCADOLIVRE_BASE_URL=https://api.mercadolibre.com
MERCADOLIVRE_SITE_ID=MLB
ML_APP_ID=                        # Opcional quando APIFY_API_TOKEN configurado
ML_CLIENT_SECRET=                 # Opcional quando APIFY_API_TOKEN configurado
ML_REQUEST_DELAY_SECONDS=1.5      # Throttle entre buscas (respeita rate limit Apify)
ML_FEE_PCT=15.0                   # Taxa ML padrão (%)
MIN_SALES_THRESHOLD=0             # 0 = sem filtro de vendas (recomendado para MVP inicial)
ML_MIN_MATCH_CONFIDENCE=0.15      # Confiança mínima de matching (0.15 = modo diagnóstico)

# ---- Claude API (Anthropic) ----
CLAUDE_API_KEY=sk-ant-sua-chave-aqui
CLAUDE_MODEL=claude-3-5-haiku-20241022  # Modelo mais barato para normalização

# ---- CORS (Frontend) ----
# Separe múltiplas origens por vírgula
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
