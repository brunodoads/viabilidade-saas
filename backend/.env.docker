# Usado pelo docker-compose — NÃO altere DATABASE_URL/REDIS_URL aqui
# Preencha suas chaves reais abaixo

APP_NAME="Viabilidade SaaS"
DEBUG=false

# JWT — OBRIGATÓRIO: troque por uma chave segura
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_ESTA_CHAVE_AGORA

# Mercado Livre — obtenha em developers.mercadolivre.com.br
ML_APP_ID=
ML_CLIENT_SECRET=

# Claude API
CLAUDE_API_KEY=

# Configurações ML (defaults razoáveis)
ML_FEE_PCT=15.0
ML_MIN_MATCH_CONFIDENCE=0.60
MIN_SALES_THRESHOLD=1000
ML_REQUEST_DELAY_SECONDS=0.5
